<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- link/joint lidar_back уже есть в astribot_whole_body_with_head.urdf -->

  <gazebo reference="lidar_back">
    <sensor name="lidar_back" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>120</samples>
            <min_angle>0.0</min_angle>
            <max_angle>6.2832</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <min_angle>-0.3</min_angle>
            <max_angle>1.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.4</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_back_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/lidar_back/points</remapping>
        </ros>
        <frame_name>lidar_back</frame_name>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <min_range>0.4</min_range>
        <max_range>20.0</max_range>
      </plugin>
    </sensor>
  </gazebo>

</robot>
