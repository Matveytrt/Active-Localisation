<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="torso_rgbd">
    <sensor name="torso_rgbd_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="torso_rgbd_controller" filename="libgazebo_ros_camera.so">
        <frame_name>torso_rgbd</frame_name>
        <camera_name>torso_rgbd</camera_name>
        <image_topic_name>/torso_rgbd/image_raw</image_topic_name>
        <camera_info_topic_name>/torso_rgbd/camera_info</camera_info_topic_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
