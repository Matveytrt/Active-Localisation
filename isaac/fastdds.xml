<?xml version="1.0" encoding="UTF-8"?>
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>al_udp_large_buffers</transport_id>
        <type>UDPv4</type>
        <!-- Raw RGB and depth are 0.92/1.23 MB per sample. Default socket
             buffers can drop their fragments even at low wall-clock FPS. -->
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="al_isaac_udp" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>al_udp_large_buffers</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
