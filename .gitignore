# Общие правила для всего репозитория. Специфичные для модулей — в конце файла.

# ROS2 / colcon (на случай сборки на хосте, в корне или в папке модуля)
build/
install/
log/
.ros/

# Артефакты CMake при сборке вне build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Скомпилированные файлы
*.o
*.so
*.a

# Логи сборки Docker и запуска: хранятся в logs/, в git попадает только сама папка
logs/*
!logs/.gitkeep
*.log

# Записи rosbag
*.bag
*.bag.active

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
.pytest_cache/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Временные файлы
*.tmp
*.bak
*.cache
.bash_history

# Переменные окружения
.env
.env.local

# navigation: базы карт RTAB-Map (сотни МБ, создаются картированием)
navigation/maps/*.db

# gazebo: траектории, которые пишет pose_saver_plugin
gazebo/src/world_and_robot/robot_poses/*.tum

# Experiment outputs (scripts/run_experiment.sh, eval/): run dirs, evo results, tables, figures.
# Anchored at the repository root; copy final figures to report/figures/ on purpose.
/al_runs/
/runs/
/eval_out/
/results/

# Map download (scripts/get_map.sh): partial downloads. The checksum manifest
# navigation/maps/astribot_sim.db.sha256 IS tracked.
navigation/maps/.*.part

# Machine-local compose overrides (GPU/WSL settings), wheels and test leftovers
compose.override.yaml
*.whl
Testing/
*.orig
*.rej
