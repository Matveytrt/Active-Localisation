<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtabmap_landmarks</name>
  <version>0.0.0</version>
  <description>RTAB-Map lidar SLAM with STag landmarks: launch files, landmarks.yaml export from the map database, marker visualization.</description>
  <maintainer email="torovdmitrii@gmail.com">dmitrytorov</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Packages launched from complete_system.launch.py -->
  <exec_depend>stag_ros2_enhanced</exec_depend>
  <exec_depend>tf_to_fiducial</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
